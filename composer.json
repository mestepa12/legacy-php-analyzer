{
    "name": "meste/legacy-php-analyzer",
    "description": "Static analyzer for legacy PHP projects: dependency graph, dead code detection and auto-generated documentation. Zero framework, AST-based (nikic/php-parser), standalone interactive HTML report.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "static-analysis",
        "dead-code-detection",
        "dependency-graph",
        "legacy-php",
        "ast",
        "documentation-generator",
        "cli"
    ],
    "authors": [
        {
            "name": "mestepa",
            "email": "mestepa120504@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "LegacyAnalyzer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LegacyAnalyzer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/analyze"
    ],
    "scripts": {
        "test": "phpunit"
    }
}
